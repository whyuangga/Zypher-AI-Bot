# ==========================================================
#  ZYPHER AI BOT — Environment
#  Salin file ini jadi .env lalu isi nilainya.
#  JANGAN commit file .env ke Git.
# ==========================================================

# ---------- Discord ----------
# https://discord.com/developers/applications -> Bot -> Reset Token
DISCORD_TOKEN=
# Application ID (ada di halaman General Information)
CLIENT_ID=

# Opsional tapi sangat disarankan saat development:
# isi dengan ID server testing -> slash command langsung muncul (instan).
# Kalau kosong, command didaftarkan global (bisa butuh sampai 1 jam).
DEV_GUILD_ID=

# ---------- AI (Groq) ----------
# Ambil API key gratis di https://console.groq.com/keys
AI_API_KEY=
# Endpoint OpenAI-compatible. Ganti ini kalau mau pindah provider
# (OpenAI, OpenRouter, Ollama, dsb) tanpa mengubah kode.
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=openai/gpt-oss-120b
AI_TEMPERATURE=0.8
AI_MAX_TOKENS=700
# Jumlah pesan terakhir yang dikirim sebagai konteks percakapan
AI_HISTORY_LIMIT=20

# ---------- Fallback multi-provider (opsional, sangat disarankan) ----------
# Kalau provider utama kena limit/error, bot otomatis pindah ke provider berikutnya.
# Format: nama:model, dipisah koma.
# Nama yang dikenal: groq, gemini, openrouter, nvidia, ollama.
# Semua provider cloud di atas (Groq, Gemini, OpenRouter, NVIDIA) tanpa kartu kredit.
# Isi hanya provider yang API key-nya kamu punya di bawah ini.
AI_FALLBACKS=
# gemini:gemini-3.8-flash,openrouter:google/gemma-4-31b-it:free,ollama:llama3.1

# API key provider cadangan — cukup isi yang dipakai.
GEMINI_API_KEY=
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
# Ollama lokal tidak butuh key; biarkan kosong.
OLLAMA_API_KEY=

# ---------- Database ----------
# Default: SQLite (satu file, tanpa server tambahan). Cukup untuk satu komunitas.
DATABASE_PATH=./data/zypher.db
# Postgres opsional (lihat docs/postgres.md). Terisi = SQLite diabaikan.
# DATABASE_URL=postgres://user:pass@host:5432/db?sslmode=require
# Multi-shard: beberapa instance bot berbagi satu database.
# SHARD_COUNT=2 dan SHARD_INDEX=0 di instance pertama, SHARD_INDEX=1 di instance kedua.
SHARD_COUNT=1
SHARD_INDEX=0

# ---------- Fitur ----------
# Simpan memori otomatis dari obrolan (pakai tool calling).
AUTO_MEMORY=true
# Batas request AI per user per menit.
RATE_LIMIT_PER_MINUTE=12
# Batas panjang pesan user yang diproses (karakter).
MAX_INPUT_CHARS=2000

# ---------- RAG dokumen (pengetahuan server) ----------
# Dokumen .txt/.md/.csv/.json dijadikan rujukan jawaban AI (/dokumen tambah atau dashboard).
RAG_ENABLED=true
# Jumlah potongan dokumen yang diselipkan ke prompt per pertanyaan.
RAG_TOP_K=5
# Panjang potongan (karakter) dan tumpang tindihnya.
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=150
# Batas total karakter satu dokumen.
RAG_MAX_CHARS=200000
# Embeddings OPSIONAL untuk pencarian semantik (butuh endpoint /embeddings kompatibel OpenAI).
# Kosong = pencarian leksikal BM25 (tanpa API key, sudah cukup untuk FAQ/docs).
# Contoh Ollama lokal:  EMBED_BASE_URL=http://localhost:11434/v1  EMBED_MODEL=nomic-embed-text
# EMBED_BASE_URL=
# EMBED_API_KEY=
# EMBED_MODEL=

# ---------- Moderasi otomatis (opsional) ----------
# Saring kata terlarang di semua channel teks. Bisa juga diatur per server
# dari dashboard /moderasi (pengaturan dashboard menang atas nilai di sini).
MODERATION_ENABLED=false
# Pisahkan dengan koma. Contoh: kata1,kata2,frasa tiga kata
MODERATION_WORDS=
# delete = hapus pesan · warn = hapus + tegur · timeout = hapus + bisukan member
MODERATION_ACTION=delete
MODERATION_TIMEOUT_MINUTES=10

# ---------- Vision: AI membaca gambar (opsional) ----------
# Member kirim gambar di room AI → model multimodal menjelaskan isinya.
# Butuh model vision di provider utama (Groq: llama-4-scout), bukan model teks biasa.
VISION_ENABLED=false
VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# Batas ukuran gambar yang diunduh bot (MB).
VISION_MAX_MB=5

# ---------- Voice: transkrip suara & balasan suara (opsional) ----------
# Voice note di room AI ditranskrip (Whisper) lalu dijawab; TTS membalas dengan audio.
VOICE_ENABLED=false
STT_MODEL=whisper-large-v3
TTS_ENABLED=true
# Otomatis membalas jawaban room AI dengan suara (selain /ucap).
# TTS_REPLY_IN_ROOM=true
# Groq: playai-tts + suara seperti Fritz-PlayAI / Celeste-PlayAI.
TTS_MODEL=playai-tts
TTS_VOICE=Fritz-PlayAI
VOICE_MAX_MB=20

# ---------- Web dashboard ----------
# Kosong = dashboard tidak dijalankan (port tidak dibuka).
# Isi dengan kata sandi acak min. 12 karakter, mis. hasil `openssl rand -hex 16`.
DASHBOARD_TOKEN=
DASHBOARD_PORT=3000
DASHBOARD_HOST=0.0.0.0
# Panel hosting kadang memberi nama lain. Bot menerima semuanya:
#   DASHBOARD_PORT > WEB_PORT > PORT > SERVER_PORT   (0 / kosong = belum diisi)
# WEB_PORT=16954
# WEB_HOST=0.0.0.0
# WEB_ENABLED=false        # matikan dashboard walau token terisi
# PUBLIC_URL=http://78.154.103.15:16954
#
# Di panel hosting (Wispbyte dsb), isi juga:
# NODE_OPTIONS=--max-old-space-size=384
# -> tanpa ini, V8 meminta heap > RAM container 512 MB dan proses dibunuh panel.
#    Variabel ini HARUS di panel (bukan di .env), karena dibaca Node saat proses mulai.

# ---------- Opsional ----------
# Level log: debug | info | warn | error
LOG_LEVEL=info
# ID kategori tempat room AI dibuat. Kosong = bot bikin kategori "AI Lounge".
AI_CATEGORY_ID=
# ID channel induk tempat private thread room AI dibuat (opsional).
# Kosong = bot membuat channel #ai-rooms sendiri di kategori di atas.
AI_ROOMS_CHANNEL_ID=
# ID channel untuk log moderasi (opsional). Transkrip TIDAK diarsipkan di sini.
MODLOG_CHANNEL_ID=
# ID role staff: bisa melihat & ikut menulis di room AI member.
STAFF_ROLE_ID=
# true = hanya admin server yang boleh membuat room AI.
ADMIN_ONLY_ROOMS=false
