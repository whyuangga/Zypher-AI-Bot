# ==========================================================
#  ZYPHER AI BOT — Environment
#  Salin file ini jadi .env lalu isi nilainya.
#  JANGAN commit file .env ke Git.
# ==========================================================

# ---------- Discord ----------
# https://discord.com/developers/applications -> Bot -> Reset Token
DISCORD_TOKEN=
# Application ID (ada di halaman General Information)
CLIENT_ID=

# Opsional tapi sangat disarankan saat development:
# isi dengan ID server testing -> slash command langsung muncul (instan).
# Kalau kosong, command didaftarkan global (bisa butuh sampai 1 jam).
DEV_GUILD_ID=

# ---------- AI (Groq) ----------
# Ambil API key gratis di https://console.groq.com/keys
AI_API_KEY=
# Endpoint OpenAI-compatible. Ganti ini kalau mau pindah provider
# (OpenAI, OpenRouter, Ollama, dsb) tanpa mengubah kode.
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=llama-3.3-70b-versatile
AI_TEMPERATURE=0.8
AI_MAX_TOKENS=700
# Jumlah pesan terakhir yang dikirim sebagai konteks percakapan
AI_HISTORY_LIMIT=20

# ---------- Database ----------
DATABASE_PATH=./data/zypher.db

# ---------- Fitur ----------
# Simpan memori otomatis dari obrolan (pakai tool calling).
AUTO_MEMORY=true
# Batas request AI per user per menit.
RATE_LIMIT_PER_MINUTE=12
# Batas panjang pesan user yang diproses (karakter).
MAX_INPUT_CHARS=2000

# ---------- Opsional ----------
# Level log: debug | info | warn | error
LOG_LEVEL=info
# ID kategori tempat room AI dibuat. Kosong = bot bikin kategori "AI Lounge".
AI_CATEGORY_ID=
# ID channel untuk arsip transkrip + ringkasan sesi.
TRANSCRIPT_CHANNEL_ID=
# ID role staff: bisa melihat & ikut menulis di room AI member.
STAFF_ROLE_ID=
# true = hanya admin server yang boleh membuat room AI.
ADMIN_ONLY_ROOMS=false
